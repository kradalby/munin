# Collapse machine-produced files in GitHub's diff view and keep them out of
# the language statistics. They are still reviewable — click to expand — but
# they do not bury the hand-written changes in a pull request.

# Vendored upstream snapshot: Sources/VIPS/Generated is emitted by
# vips-generator, the rest is kradalby/swift-vips verbatim, and exactly one
# file (Package.swift, 34 lines) is hand-edited. See VENDORED.md.
#
# `linguist-generated`, not `linguist-vendored`, even though this is vendored
# rather than generated: only the former collapses a file in GitHub's diff
# view, which is the point. `linguist-vendored` just drops it from the
# language statistics and leaves 21k lines in the way of a reviewer.
vendor/** linguist-generated=true

# ...except the one file worth reading, which stays expanded.
vendor/swift-vips/Package.swift -linguist-generated
vendor/swift-vips/VENDORED.md -linguist-generated

# The parity baseline: whatever `munin` writes for example/album. Regenerated
# with scripts/regen-example-content.sh, never edited by hand.
example/content/** linguist-generated=true
